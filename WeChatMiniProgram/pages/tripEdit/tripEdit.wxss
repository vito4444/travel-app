.color-row {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx 24rpx;
}

.color-dot {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 22rpx;
  margin-bottom: 12rpx;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
