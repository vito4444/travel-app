.stat-row {
  display: flex;
  margin-bottom: 20rpx;
}

.stat-card {
  flex: 1;
  background: #ffffff;
  border-radius: 20rpx;
  text-align: center;
  padding: 22rpx 0;
  margin-right: 16rpx;
}

.stat-card:last-child {
  margin-right: 0;
}

.stat-icon {
  font-size: 30rpx;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  margin: 4rpx 0;
}

.map-card {
  position: relative;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.stats-map {
  width: 100%;
  height: 560rpx;
}

.map-count {
  position: absolute;
  left: 16rpx;
  bottom: 16rpx;
  background: rgba(255, 255, 255, 0.9);
  font-size: 20rpx;
  color: #3a3a3c;
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
}

.dest-wrap {
  display: flex;
  flex-wrap: wrap;
}

.dest-chip {
  background: #ffffff;
  border-radius: 999rpx;
  font-size: 24rpx;
  padding: 10rpx 24rpx;
  margin: 0 14rpx 14rpx 0;
}
