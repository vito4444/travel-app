.status-badge {
  font-size: 22rpx;
  font-weight: 700;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.tool-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.tool-btn {
  width: 33.33%;
  box-sizing: border-box;
  text-align: center;
  font-size: 24rpx;
  color: #3a3a3c;
  padding: 14rpx 0;
}

.edit-toggle {
  font-size: 24rpx;
  color: #1E7ADB;
  padding: 10rpx;
}

.item-row {
  display: flex;
  align-items: flex-start;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f2f2f7;
}

.item-row:last-of-type {
  border-bottom: none;
}

.item-time {
  width: 88rpx;
  text-align: right;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.item-time-start {
  font-size: 26rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.item-time-end {
  font-size: 20rpx;
  color: #8e8e93;
  font-variant-numeric: tabular-nums;
}

.item-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.item-title {
  font-size: 28rpx;
  font-weight: 500;
  max-width: 70%;
}

.type-badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.chips-row {
  display: flex;
  flex-wrap: wrap;
}

.sort-col {
  display: flex;
  flex-direction: column;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.sort-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 12rpx;
  background: #f2f2f7;
  color: #3a3a3c;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  margin-bottom: 8rpx;
}

.sort-del {
  color: #e8574c;
}

.add-row {
  text-align: center;
  color: #1E7ADB;
  font-size: 26rpx;
  padding: 22rpx 0;
}
