.map-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f6f8;
}

.day-scroll {
  white-space: nowrap;
  padding: 16rpx 16rpx 8rpx;
  flex-shrink: 0;
}

.day-chip {
  display: inline-block;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 10rpx 24rpx;
  margin-right: 14rpx;
  text-align: center;
  color: #1c1c1e;
}

.day-chip-active {
  color: #ffffff;
}

.day-chip-title {
  font-size: 24rpx;
  font-weight: 700;
}

.day-chip-date {
  font-size: 20rpx;
  opacity: 0.8;
}

.map-wrap {
  flex: 1;
  min-height: 400rpx;
  position: relative;
}

.the-map {
  width: 100%;
  height: 100%;
}

.controls {
  display: flex;
  align-items: center;
  padding: 14rpx 16rpx;
  background: #ffffff;
  flex-shrink: 0;
}

.mode-seg {
  display: flex;
  background: #f2f2f7;
  border-radius: 14rpx;
  padding: 4rpx;
  margin-right: 14rpx;
}

.mode-btn {
  font-size: 22rpx;
  padding: 10rpx 16rpx;
  border-radius: 12rpx;
  color: #3a3a3c;
}

.mode-btn-active {
  background: #ffffff;
  font-weight: 600;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.12);
}

.ctl-btn {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  font-weight: 600;
  padding: 14rpx 0;
  border-radius: 14rpx;
  background: #eef3fb;
  color: #1E7ADB;
  margin-right: 12rpx;
}

.ctl-btn:last-child {
  margin-right: 0;
}

.ctl-btn-primary {
  color: #ffffff;
}

.leg-panel {
  height: 260rpx;
  background: #ffffff;
  flex-shrink: 0;
}

.leg-row {
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #f2f2f7;
}

.leg-seq {
  font-size: 22rpx;
  color: #8e8e93;
  font-weight: 700;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.estimate-tag {
  font-size: 20rpx;
  background: rgba(255, 204, 0, 0.25);
  color: #8a6d00;
  border-radius: 999rpx;
  padding: 2rpx 12rpx;
  margin-left: 10rpx;
}
